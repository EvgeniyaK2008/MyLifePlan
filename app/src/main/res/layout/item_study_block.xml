<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Текстовое тело блока -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_block_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Algorithms &amp; Practice"
                android:textColor="#3D4A54"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_block_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Solve LeetCode dynamic programming tasks..."
                android:textColor="#8A9BA8"
                android:textSize="13sp" />

            <!-- Чипы статуса: дедлайн и цель времени -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F8EAEB"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="🗓 Oct 21"
                    android:textColor="#BA5A63"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chip_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#E7F0F8"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="⏱ Target: 1h"
                    android:textColor="#4878A4"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Разделитель -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#F0F4F8" />

        <!-- Правый сайдбар управления в стиле Colab -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="#FAFCFD"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Кнопка запуска таймера ▶️ -->
            <ImageButton
                android:id="@+id/btn_run_timer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Run Timer"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/start" />

            <!-- Кнопка параметров ⚙️ -->
            <ImageButton
                android:id="@+id/btn_edit_params"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_preferences" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>