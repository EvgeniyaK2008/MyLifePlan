<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_cell_container"
    android:layout_width="54dp"
    android:layout_height="72dp"
    android:layout_marginHorizontal="4dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- День недели (Mon, Tue...) -->
    <TextView
        android:id="@+id/tv_day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon"
        android:textColor="#8A9BA8"
        android:textSize="11sp" />

    <!-- Круг даты (используем твой bg_selected_day из папки drawable) -->
    <FrameLayout
        android:id="@+id/frame_day_circle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_selected_day">

        <TextView
            android:id="@+id/tv_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="17"
            android:textColor="#3D4A54"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Цветная точка-индикатор -->
    <View
        android:id="@+id/view_tag_color_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_circle" />
</LinearLayout>