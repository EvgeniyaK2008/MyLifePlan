<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    tools:context=".CalorieActivity">

    <!-- Верхняя панель навигации (Заголовок и Кнопка назад) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/calorie_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Calorie Tracker"
            android:textColor="#9BB0C1"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_back"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="@id/btn_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Прокручиваемый контент -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Карта 1: Горизонтальный недельный календарь -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="July 2026"
                        android:textColor="#8A9BA8"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mo" android:textColor="#8A9BA8" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17" android:textColor="#8A9BA8" android:textSize="14sp" android:layout_marginTop="4dp"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tu" android:textColor="#8A9BA8" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18" android:textColor="#8A9BA8" android:textSize="14sp" android:layout_marginTop="4dp"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="We" android:textColor="#8A9BA8" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19" android:textColor="#8A9BA8" android:textSize="14sp" android:layout_marginTop="4dp"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Th" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/><TextView android:layout_width="32dp" android:layout_height="32dp" android:text="20" android:textColor="#8A9BA8" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/bg_selected_day" android:layout_marginTop="4dp"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fr" android:textColor="#8A9BA8" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21" android:textColor="#8A9BA8" android:textSize="14sp" android:layout_marginTop="4dp"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sa" android:textColor="#8A9BA8" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22" android:textColor="#8A9BA8" android:textSize="14sp" android:layout_marginTop="4dp"/></LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Su" android:textColor="#8A9BA8" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="23" android:textColor="#8A9BA8" android:textSize="14sp" android:layout_marginTop="4dp"/></LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Карта 2: Круговой счетчик калорий -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_grid_card"
                android:padding="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ProgressBar
                        android:id="@+id/calorie_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:max="1500"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_circular_progress"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@id/calorie_progress_bar"
                        app:layout_constraintEnd_toEndOf="@id/calorie_progress_bar"
                        app:layout_constraintStart_toStartOf="@id/calorie_progress_bar"
                        app:layout_constraintTop_toTopOf="@id/calorie_progress_bar">

                        <TextView
                            android:id="@+id/tv_current_calories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="1.5dp"
                            android:layout_marginVertical="4dp"
                            android:background="#BFCFD9" />

                        <TextView
                            android:id="@+id/tv_target_calories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1500"
                            android:textColor="#BFCFD9"
                            android:textSize="15sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <!-- Карта 3: Поля ввода параметров и Слайдер целей -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Калькулятор нормы"
                        android:textColor="#8A9BA8"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <EditText
                            android:id="@+id/et_height"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_button_white"
                            android:hint="Рост (см)"
                            android:gravity="center"
                            android:inputType="number"
                            android:textColor="#8A9BA8"
                            android:textColorHint="#BFCFD9"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/et_weight"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_button_white"
                            android:hint="Вес (кг)"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:textColor="#8A9BA8"
                            android:textColorHint="#BFCFD9"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/et_age"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_button_white"
                            android:hint="Возраст"
                            android:gravity="center"
                            android:inputType="number"
                            android:textColor="#8A9BA8"
                            android:textColorHint="#BFCFD9"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_calculate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_white"
                        android:text="Рассчитать нормы"
                        android:textAllCaps="false"
                        android:textColor="#8A9BA8" />

                    <!-- Расшифровка безопасных зон и ИНТЕРАКТИВНЫЙ ПОЛЗУНОК -->
                    <LinearLayout
                        android:id="@+id/ranges_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_norm_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ваша норма: 1500 ккал"
                            android:textColor="#8A9BA8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Текстовый индикатор текущего выбора на ползунке -->
                        <TextView
                            android:id="@+id/tv_selected_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Выбранная цель: 1500 ккал"
                            android:textColor="#8A9BA8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Интерактивный ползунок для целей -->
                        <SeekBar
                            android:id="@+id/sb_calorie_target"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:progressDrawable="@drawable/bg_progress_bar"
                            android:thumb="@drawable/bg_selected_day"
                            android:splitTrack="false" />

                        <TextView
                            android:id="@+id/tv_deficit_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Дефицит (похудение): 1100 - 1300 ккал"
                            android:textColor="#E57373"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_surplus_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Профицит (набор): 1700 - 2000 ккал"
                            android:textColor="#81C784"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Карта 4: Список съеденных продуктов -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Продукты за день"
                        android:textColor="#8A9BA8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/meals_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:nestedScrollingEnabled="true"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_meal" />

                    <TextView
                        android:id="@+id/btn_add_meal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="12dp"
                        android:padding="4dp"
                        android:text="+ add"
                        android:textColor="#9BB0C1"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>