<?xml version="1.0" encoding="utf-8"?>
<!--
    ВАЖНО: диагональные полосы через rotation в XML — это приближение.
    Для точного повторения дизайна лучше экспортировать этот фон как
    единый PNG/SVG-ассет из Figma и поставить его через
    android:src / android:background у ImageView на весь экран.
    Ниже — рабочий вариант "из коробки", который можно подвинуть в Preview.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:clipChildren="true">

    <!-- Диагональные полосы (от меньшей к большей, снизу вверх по коду = сзади вперёд) -->
    <View
        android:layout_width="140dp"
        android:layout_height="340dp"
        android:layout_marginStart="-40dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_stripe"
        android:rotation="35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="140dp"
        android:layout_height="420dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_stripe"
        android:rotation="35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="140dp"
        android:layout_height="480dp"
        android:layout_marginStart="70dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_stripe"
        android:rotation="35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="140dp"
        android:layout_height="520dp"
        android:layout_marginStart="140dp"
        android:layout_marginTop="-40dp"
        android:background="@drawable/bg_stripe"
        android:rotation="35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="140dp"
        android:layout_height="560dp"
        android:layout_marginStart="210dp"
        android:layout_marginTop="-80dp"
        android:background="@drawable/bg_stripe"
        android:rotation="35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Аватарка поверх полос -->
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_circle"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_myplaces"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>