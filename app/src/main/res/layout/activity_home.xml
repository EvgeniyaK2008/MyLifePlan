<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Кнопка профиля (аватарка в зеркальной раме) -->
    <ImageButton
        android:id="@+id/btn_profile"
        android:layout_width="68dp"
        android:layout_height="87dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/desc_profile_avatar"
        android:padding="10dp"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_universal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Заголовок (центрирован по вертикали относительно аватарки) -->

    <!-- Линия под заголовком "Welcome home" -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="@string/welcome_home"
        android:textColor="#9BB0C1"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="@id/btn_profile"
        app:layout_constraintStart_toEndOf="@id/btn_profile"
        app:layout_constraintTop_toTopOf="@id/btn_profile"
        app:layout_constraintVertical_bias="0.187" />

    <View
        android:id="@+id/title_underline"
        android:layout_width="0dp"
        android:layout_height="1.5dp"
        android:layout_marginTop="2dp"
        android:background="#D1DCE8"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintEnd_toEndOf="@id/title" />

    <!-- Иконка меню (выровнена по линии заголовка) -->
    <ImageView
        android:id="@+id/menu_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/desc_menu"
        android:src="@drawable/ic_menu"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <!-- Вертикальный контейнер игровой валюты (Звезда вверху, счет внизу) -->
    <LinearLayout
        android:id="@+id/coins_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/menu_icon"
        app:layout_constraintEnd_toStartOf="@id/menu_icon"
        app:layout_constraintTop_toTopOf="@id/menu_icon">

        <!-- Иконка звездочки (прозрачный фон) -->
        <ImageView
            android:id="@+id/iv_star_currency"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/star_coin_ico" />

        <!-- Небольшая надпись счета под ней -->
        <TextView
            android:id="@+id/tv_main_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0.00"
            android:textColor="#8A9BA8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Карточка Plans (размер блока 353dp сохранен) -->
    <FrameLayout
        android:id="@+id/plans_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_home_card"
        app:layout_constraintEnd_toStartOf="@id/motivation_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_profile"
        app:layout_constraintWidth_percent="0.55">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="353dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/plans_title"
                android:textColor="#8A9BA8"
                android:textSize="18sp" />

            <!-- Список планов (высота 0dp и вес 1 позволяют кнопке "+ add" всегда оставаться внизу) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/plans_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:nestedScrollingEnabled="true"
                tools:itemCount="3"
                tools:listitem="@layout/item_plan" />

            <!-- Кнопка добавить всегда зафиксирована внизу карточки -->
            <TextView
                android:id="@+id/add_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:padding="4dp"
                android:text="@string/add_btn_text"
                android:textColor="#9BB0C1"
                android:textSize="15sp" />

        </LinearLayout>
    </FrameLayout>

    <!-- Карточка Мотивации (Высота ровно 155dp, как в исходном шаблоне) -->
    <FrameLayout
        android:id="@+id/motivation_card"
        android:layout_width="0dp"
        android:layout_height="155dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_home_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/plans_card"
        app:layout_constraintTop_toBottomOf="@id/btn_profile">

        <!-- Квадратная картинка с вашей мотивацией -->
        <ImageView
            android:id="@+id/iv_motivation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/motivation" /> <!-- Замените на вашу картинку -->
    </FrameLayout>

    <!-- Карточка Питомца (Высота ровно 186dp, встает на место пустой карточки) -->
    <FrameLayout
        android:id="@+id/pet_card"
        android:layout_width="0dp"
        android:layout_height="186dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_card"
        app:layout_constraintEnd_toEndOf="@id/motivation_card"
        app:layout_constraintStart_toStartOf="@id/motivation_card"
        app:layout_constraintTop_toBottomOf="@id/motivation_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Картинка котенка (с прозрачным фоном) -->
            <ImageView
                android:id="@+id/iv_pet"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:scaleType="fitCenter"
                android:src="@drawable/motivation" /> <!-- Спящий котенок -->

            <!-- Статус питомца -->
            <TextView
                android:id="@+id/tv_pet_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Котёнок спит... 💤"
                android:textColor="#8A9BA8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Кнопка покормить за монеты -->
            <TextView
                android:id="@+id/btn_feed_pet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="Покормить (10 ⭐)"
                android:textColor="#9BB0C1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Барьер для определения нижней границы (теперь ссылается на plans_card и pet_card) -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/columns_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="plans_card,pet_card" />


    <!-- Большая нижняя карточка с сеткой навигации (Зафиксирована по высоте и прижата к низу) -->
    <FrameLayout
        android:id="@+id/grid_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_grid_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/columns_barrier"
        app:layout_constraintVertical_bias="1.0"> <!-- Прижимает панель строго к низу экрана на длинных дисплеях -->

    <!-- Высоту GridLayout оставляем фиксированной 193dp, чтобы кнопки сохраняли свои пропорции -->
    <GridLayout
        android:id="@+id/apps_grid"
        android:layout_width="match_parent"
        android:layout_height="193dp"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:padding="16dp"
        android:rowCount="3">

        <!-- Кнопки-плитки (btn_section_1 ... btn_section_8) остаются без изменений -->
        <ImageButton
            android:id="@+id/btn_section_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/study_ico" />

        <ImageButton
            android:id="@+id/btn_section_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/diet_ico" />

        <ImageButton
            android:id="@+id/btn_section_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/games_ico" />

        <ImageButton
            android:id="@+id/btn_section_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/calendar_ico" />

        <ImageButton
            android:id="@+id/btn_section_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sounds_ico" />

        <ImageButton
            android:id="@+id/btn_section_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/statistics_ico" />

        <ImageButton
            android:id="@+id/btn_section_7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/dairy_ico" />

        <ImageButton
            android:id="@+id/btn_section_8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="8dp"
            android:background="@drawable/bg_grid_square"
            android:contentDescription="@string/desc_grid_button"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sport_ico" />

    </GridLayout>
</FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>